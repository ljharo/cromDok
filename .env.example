# Copia este archivo a .env y ajusta lo que necesites. docker-compose.yml ya
# calcula CRONDOK_HOST_DATA_DIR automáticamente (${PWD}/data) — normalmente
# no hace falta tocar nada para levantar el stack con valores por defecto.

# Clave Fernet para cifrar variables de entorno en reposo (spec 9.1). Si se
# deja vacía, se autogenera en el primer arranque y se persiste en
# data/.master_key — recomendado fijarla explícitamente en producción si vas
# a migrar CronDok de host (sin esta clave, los secrets cifrados son
# irrecuperables).
CRONDOK_MASTER_KEY=

# Ejecuciones concurrentes máximas (semáforo del executor).
CRONDOK_MAX_CONCURRENT_JOBS=4

# Días de retención de ejecuciones/logs terminados antes de la purga diaria.
CRONDOK_LOG_RETENTION_DAYS=30

# Límite de POST /triggers/{id} por identidad (requests/minuto).
CRONDOK_RATE_LIMIT_TRIGGERS=100

# Webhook opcional notificado en cada ejecución fallida (vacío = no-op).
CRONDOK_WEBHOOK_URL=

# Flag Secure de la cookie de sesión. Actívalo SOLO detrás de un proxy TLS;
# con HTTP plano el navegador no devolvería la cookie y el login fallaría.
CRONDOK_COOKIE_SECURE=false

# IPs de reverse proxies de confianza (separadas por coma). Solo si el peer
# está en esta lista, el rate limit de login usa la primera IP de
# X-Forwarded-For en vez de la IP del proxy. Vacío = nunca se confía.
CRONDOK_TRUSTED_PROXIES=
